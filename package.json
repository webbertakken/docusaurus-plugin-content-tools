{
  "name": "docusaurus-plugin-content-tools",
  "version": "0.1.0",
  "description": "Easy overview with routes to your tools",
  "keywords": [
    "docusaurus",
    "plugin",
    "theme",
    "tools",
    "homepage"
  ],
  "homepage": "https://github.com/webbertakken/docusaurus-plugin-content-tools",
  "bugs": "https://github.com/webbertakken/docusaurus-plugin-content-tools/issues",
  "repository": "https://github.com/webbertakken/docusaurus-plugin-content-tools.git",
  "author": "Webber <webber.nl@gmail.com>",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "src/types/index.d.ts",
  "files": [
    "src/*",
    "lib/*"
  ],
  "scripts": {
    "build": "concurrently yarn:build:plugin yarn:build:theme yarn:build:assets",
    "watch": "concurrently \"yarn:build:plugin --watch\" \"yarn:build:theme --watch\" \"yarn:build:assets --watch\"",
    "build:plugin": "tsc",
    "build:theme": "tsc --build tsconfig.theme.json",
    "build:assets": "node scripts/copyUntypedFiles.mjs",
    "test": "node scripts/ensure-husky.mjs && vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "yarn oxlint --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "typecheck:tsgo": "tsgo --noEmit",
    "setup:hooks": "node scripts/ensure-husky.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.@(ts|tsx|mts|js|jsx|mjs|cjs)": [
      "oxlint --fix --quiet",
      "oxfmt --write"
    ],
    "*.@(json|jsonc|json5|md|mdx|yaml|yml|css|scss|sass|html|toml)": "oxfmt --write",
    ".github/workflows/*.@(yml|yaml)": "actionlint"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/theme-classic": "^3.0.0",
    "@docusaurus/theme-common": "3.10.2",
    "@docusaurus/theme-translations": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@docusaurus/utils-validation": "^3.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.0.0",
    "@octokit/types": "^18.0.0",
    "@types/node": "^17.0.35",
    "@types/react": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260505.1",
    "@vitest/coverage-istanbul": "^5.0.5",
    "chokidar": "^6.0.0",
    "classnames": "^2.3.1",
    "concurrently": "^10.0.0",
    "fs-extra": "^11.0.0",
    "happy-dom": "^21.0.0",
    "husky": "9",
    "lint-staged": "^17.0.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.63.0",
    "typescript": "^7.0.0",
    "vite": "^8.0.0",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^18.0.0||^19.0.0",
    "react-dom": "^18.0.0||^19.0.0"
  },
  "packageManager": "yarn@4.18.1",
  "dependenciesMeta": {
    "core-js": {
      "built": true
    },
    "core-js-pure": {
      "built": true
    }
  },
  "resolutions": {
    "minimatch@npm:3.1.5": "^11.0.3",
    "serialize-javascript@npm:^6.0.0": "^7.1.4",
    "serialize-javascript@npm:^6.0.1": "^7.1.4",
    "serve-handler@npm:^6.1.7": "patch:serve-handler@npm%3A6.1.7#~/.yarn/patches/serve-handler-npm-6.1.7-b26917d24b.patch",
    "tinypool@npm:^1.0.2": "^2.2.0",
    "uuid@npm:^8.3.2": "^14.0.0"
  }
}
